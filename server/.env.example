# Your GitHub personal access token (needs 'copilot' scope)
GITHUB_TOKEN=ghp_your_token_here

# A secret key the iOS app uses to authenticate to this server
API_KEY=change_me_to_a_strong_random_secret

# Server port (default: 3000)
PORT=3003

# Copilot model to use (gpt-4o, claude-3.5-sonnet, o1-mini, etc.)
MODEL=gpt-4o

# Copilot API endpoint (default: GitHub Copilot chat)
COPILOT_API_URL=https://models.inference.ai.azure.com/chat/completions

# Cloudflare named tunnel token (from: cloudflared tunnel token <tunnel-name>)
# Leave blank to use a quick tunnel (URL changes every restart)
CLOUDFLARE_TUNNEL_TOKEN=
